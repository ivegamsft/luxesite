{
  "name": "luxesite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "cd ../.. && npx --prefix apps/web jest --config tests/unit/jest.config.js",
    "test:watch": "cd ../.. && npx --prefix apps/web jest --config tests/unit/jest.config.js --watch",
    "test:e2e": "playwright test --config ../../tests/e2e/playwright.config.ts",
    "test:e2e:headed": "playwright test --config ../../tests/e2e/playwright.config.ts --headed",
    "test:e2e:report": "playwright show-report ../../tests/e2e/playwright-report"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "next": "16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.9",
    "typescript": "^5"
  }
}
